WHITESPACE      = [ \t\r\n]+
LINE_COMMENT    = //[^\n]*
BLOCK_COMMENT   = /\*[\s\S]*?\*/

STRING          = "([^"\\]|\\.)*"
NUMBER          = -?[0-9]+(\.[0-9]+)?
INTEGER         = -?[0-9]+
IDENTIFIER      = [A-Za-z_][A-Za-z0-9_]*

LEFT_BRACE      = \{
RIGHT_BRACE     = \}
LEFT_PAREN      = \(
RIGHT_PAREN     = \)
COMMA           = ,
SEMICOLON       = ;
EQUAL           = =
PLUS            = \+
MINUS           = -
STAR            = \*
SLASH           = /

EQUAL_EQUAL     = ==
BANG_EQUAL      = !=
LESS_EQUAL      = <=
GREATER_EQUAL   = >=
LESS            = <
GREATER         = >

KEYWORDS        = city road building parking park zone junction marker sensor query let nil line bend polyline polygon box circ nearby where sortBy highlight set
ENUMS           = OPEN CONGESTED WORKS CLOSED UNKNOWN FREE PAID MIXED FULL
BOOLS           = true false